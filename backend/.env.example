# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL only)
DATABASE_URL="mysql://root:password@localhost:3306/lms_db"

# Auth
JWT_SECRET=change-me-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=change-me-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
